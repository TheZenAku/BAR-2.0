# Copie para .env (não versionado). Nunca coloque segredos reais neste arquivo.
NODE_ENV=development
HOST=127.0.0.1
PORT=2567
LOG_LEVEL=info

# PostgreSQL local (npm run db:up com Docker, ou npm run db:local sem Docker). Troque a senha.
POSTGRES_USER=bar
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=bar
POSTGRES_PORT=5432
DATABASE_URL=postgres://bar:troque-esta-senha-local@127.0.0.1:5432/bar
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=10000
# DB_AUTO_MIGRATE=true

# Sessão e segurança. Em produção: COOKIE_SECURE é forçado e ALLOWED_ORIGINS é obrigatório.
# SESSION_TTL_HOURS=720
# PASSWORD_RESET_TTL_MINUTES=30
# COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://127.0.0.1:5173
# TRUST_PROXY=false

# Recuperação de acesso: dev-outbox grava o link em .data/outbox (proibido em produção); disabled não envia nada.
MAIL_TRANSPORT=dev-outbox
