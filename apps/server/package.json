{
  "name": "@bar/server",
  "private": true,
  "version": "0.0.0",
  "description": "Servidor autoritativo do B.A.R. (API HTTP, PostgreSQL, contas e sessões; sala multiplayer Colyseus).",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@bar/game-core": "0.0.0",
    "@bar/shared": "0.0.0",
    "@colyseus/core": "0.18.23",
    "@colyseus/ws-transport": "0.18.4",
    "@fastify/cookie": "11.1.3",
    "fastify": "5.12.7",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@colyseus/sdk": "0.18.8"
  }
}
