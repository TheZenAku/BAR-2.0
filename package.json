{
  "name": "bar",
  "private": true,
  "version": "0.0.0",
  "description": "B.A.R. — jogo social multiplayer 3D para navegadores.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.7.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @bar/server",
    "dev:client": "npm run dev -w @bar/client",
    "demo": "node scripts/demo.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:local": "node scripts/db-local.mjs",
    "db:migrate": "npm run db:migrate -w @bar/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:arch": "node scripts/check-architecture.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:arch && npm run check:licenses",
    "test:e2e": "npm run build -w @bar/client && node tests/e2e/boot.e2e.mjs && node tests/e2e/multiplayer.e2e.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "embedded-postgres": "18.4.0-beta.17",
    "pg": "8.23.1",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
